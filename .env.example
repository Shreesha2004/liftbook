# Copy to .env and fill in. .env is git-ignored.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workout_db

# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# development | production | test  (production requires a real SECRET_KEY and sets secure cookies)
ENVIRONMENT=development

# Create the demo account with six months of generated history on startup
SEED_DEMO_DATA=false
